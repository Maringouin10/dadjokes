# Copie ce fichier en ".env" (à côté de docker-compose.yml), remplis-le, puis :
#   docker compose up -d --build
# Une ligne vide ou absente = valeur par défaut (indiquée ici).
# Tout peut aussi se changer dans /admin → Réglages : la valeur de /admin remplace celle d'ici.

# ---------- Site ----------
# Adresse publique du site, en https (liens des e-mails, notifications push, code QR)
PUBLIC_URL=https://blaguedujour.lol
SITE_NAME=La blague plate du jour

# ---------- Blagues ----------
# Meilleures blagues : clé gratuite sur https://www.blagues-api.fr
BLAGUES_API_TOKEN=
# Fuseau horaire et heure (0-23) du changement de blague, jours d'historique
TIME_ZONE=America/New_York
CHANGE_HOUR=12
HISTORY_DAYS=7
# Texte affiché sur le site et dans les e-mails ("Nouvelle blague <texte>")
SCHEDULE_TEXT=chaque jour à midi (heure de New York)

# ---------- Admin (/admin) ----------
# Mot de passe (vide = page désactivée), durée de connexion en jours
ADMIN_PASSWORD=
ADMIN_SESSION_DAYS=7
# Nombre de jours affichés dans les stats
STATS_DAYS=30
# Moteurs de recherche dont les visites comptent comme humaines (en plus du code QR et de l'app)
HUMAN_REFERRERS=google,bing,duckduckgo,qwant,ecosia,yahoo
# Réseaux sociaux dont les visites comptent aussi comme humaines (un lien avec ?src=nom compte aussi)
SOCIAL_REFERRERS=facebook,instagram,tiktok,youtube,reddit,pinterest,linkedin,twitter,x,threads,snapchat,whatsapp,messenger,telegram

# ---------- Code QR, étiquettes et affiches ----------
# Adresse du code QR ("?qr" sert à compter les scans) et adresse écrite sous le code
QR_URL=https://blaguedujour.lol/?qr
QR_TEXT=blaguedujour.lol
# Étiquette pour imprimante thermique (en pouces) et ses textes
LABEL_WIDTH_IN=3
LABEL_HEIGHT_IN=1
LABEL_TITLE=La blague plate du jour
LABEL_TEXT=Scanne-moi : une nouvelle blague plate chaque jour à midi !
# Affiche : 4 fois la même sur une feuille (LETTER ou A4)
POSTER_PAGE=LETTER
POSTER_TITLE=La blague plate du jour
POSTER_TEXT=Scanne le code : une nouvelle blague plate chaque jour à midi. Promis, elle est nulle.

# ---------- Demandes d'étiquettes (/ads) ----------
ADS_MAX_LABELS=200
ADS_TITLE=Plus d’étiquettes ?
ADS_TEXT=Tu colles des étiquettes de la blague du jour et tu n’en as plus ? Dis combien il t’en faut et ton numéro de casier : on te les dépose.

# ---------- E-mails (https://resend.com) ----------
RESEND_API_KEY=
EMAIL_FROM=La blague plate du jour <blague@blaguedujour.lol>
# Facultatif : une vraie boîte qui reçoit les réponses
EMAIL_REPLY_TO=info@blaguedujour.lol

# ---------- Vérification des blagues par IA (https://console.groq.com, gratuit) ----------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Instagram (Meta for Developers) ----------
# Publie chaque jour à midi la question de la blague (image + légende) ; la réponse est sur le site (lien dans la bio).
# Jeton : developers.facebook.com → ton app → Instagram → « API setup with Instagram login » → Generate token.
# Vide = pas de publication. Le jeton (60 jours) est renouvelé tout seul.
INSTAGRAM_ACCESS_TOKEN=
# Facultatif avec un jeton Instagram (IG…), obligatoire avec un jeton de Page Facebook (EAA…)
INSTAGRAM_USER_ID=
# Légende : le plus simple est de la changer dans /admin → Réglages. Ici, mets-la entre guillemets simples
# (sinon les #hashtags sont pris pour un commentaire). {question} = la question, \n = retour à la ligne.
# INSTAGRAM_CAPTION='{question}\n\n🤫 La réponse ? Va sur la bio, il y a le lien 👆 @blaguedujour.lol\n\n#blague #blaguedujour #humour #blagueplate #jeudemots'
INSTAGRAM_TEASER=La réponse ? Le lien est dans la bio

# ---------- Anti-robot : Cloudflare Turnstile (dash.cloudflare.com → Turnstile) ----------
# Protège l’inscription par e-mail et les signalements. Vide = désactivé.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Signalements ----------
REPORT_THRESHOLD=10
REPORT_REPLACE_HOURS=6

# ---------- Confidentialité (Loi 25, Québec) ----------
# Responsable de la protection des renseignements personnels (affiché sur /confidentialite)
PRIVACY_OFFICER=
PRIVACY_EMAIL=info@blaguedujour.lol

# ---------- Notifications push ----------
# Ton adresse e-mail (contact pour les services de push)
VAPID_SUBJECT=
# Facultatif : clés VAPID (sinon générées au premier démarrage)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
