# Copie ce fichier en ".env" (à côté de docker-compose.yml) et remplis-le.

# Meilleures blagues : clé gratuite sur https://www.blagues-api.fr (la meilleure source en français)
BLAGUES_API_TOKEN=

# Adresse publique du site (liens des e-mails, notifications push, code QR)
PUBLIC_URL=https://blaguedujour.lol

# Mot de passe de la page /admin (vide = page désactivée)
ADMIN_PASSWORD=

# E-mails via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=La blague plate du jour <blague@blaguedujour.lol>

# Ton adresse e-mail (contact pour les notifications push)
VAPID_SUBJECT=
